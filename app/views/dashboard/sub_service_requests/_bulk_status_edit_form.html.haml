.modal-dialog{ role: 'document' }
  .modal-content
    -# = form_for in_dashboard? ? [:dashboard, document] : document, remote: true do |f|
    -#   = f.hidden_field :protocol_id
    -#   - unless in_dashboard?
    -#     = hidden_field_tag :srid, service_request.id
    = hidden_field_tag :ssr_ids, sub_service_requests.pluck(:id).to_a
    .modal-header
      %h3.modal-title
        = "Edit Request Statuses"
      %button.close{ type: 'button', data: { dismiss: 'modal' }, aria: { label: t('actions.close') } }
        %span{ aria: { hidden: 'true' } } &times;
    .modal-body
      %table.ssr-modal-table{ data: { toggle: 'table', search: 'true', 'show-columns' => 'true', 'show-refresh' => 'true', striped: 'true', sort_name: 'srid', sort_order: 'ASC'} }
        %thead.bg-light
          %tr
            %th
              = "SRID"
            %th
              = "Organization"
            %th
              = "Owner"
            %th
              = "Status"
            %th
              = "Submitted On"
        %tbody
          - sub_service_requests.each do |ssr|
            %tr
              %td 
                = ssr.display_id
              %td 
                = ssr.org_tree_display
              %td 
                = ssr.owner.try(&:full_name)
              %td
                = display_status(ssr)
              = hidden_field_tag "ssr_#{ssr.id}", value: "", class: 'updated_status'
              %td 
                = format_datetime(ssr.submitted_at)
      .mt-3
        %label{for: 'status_select'}
          = "Change All Statuses To"
        %select{name: 'status_select', id: 'status_select_dropdown'}
          %option{value: 'awaiting_pi_approval'} 
            = 'Awaiting Requestor Response'
          %option{value: 'complete'} 
            = 'Complete'
          %option{value: 'draft'} 
            = 'Draft'
          %option{value: 'in_process'} 
            = 'In Process'
          %option{value: 'on_hold'} 
            = 'On Hold' 
          %option{value: 'submitted'} 
            = 'Submitted' 
    .modal-footer
      %button.btn.btn-secondary{ type: 'button', data: { dismiss: 'modal' } }
        = t(:actions)[:close]
      %button.btn.btn-primary{ type: 'submit', id: 'bulk_status_submit_button', data: { disable: true } }<
        = t('actions.submit')
